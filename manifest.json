{
  "manifest_version": 3,
  "name": "YouListen",
  "version": "1.2.1",
  "description": "Hide YouTube video, keep the audio and controls, and track listening versus watching time locally.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouListen",
    "default_icon": {
      "16": "youlisten-icon.png",
      "32": "youlisten-icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "css": [
        "hide-video.css"
      ],
      "js": [
        "settings.js",
        "tracking-core.js",
        "content.js",
        "playback.js"
      ],
      "run_at": "document_start"
    }
  ],
  "minimum_chrome_version": "109",
  "icons": {
    "16": "youlisten-icon.png",
    "32": "youlisten-icon.png",
    "48": "youlisten-icon.png",
    "128": "youlisten-icon.png"
  }
}
